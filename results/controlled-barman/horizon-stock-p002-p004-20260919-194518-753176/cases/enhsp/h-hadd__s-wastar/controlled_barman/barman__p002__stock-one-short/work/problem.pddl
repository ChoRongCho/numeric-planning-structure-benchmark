(define (problem numeric-barman-p002) (:domain numeric-barman)
  (:objects
    left right - hand
    level0 level1 level2 - level
    ingredient1 ingredient2 ingredient3 ingredient4 - ingredient
    cocktail1 cocktail2 cocktail3 - cocktail
    dispenser1 dispenser2 dispenser3 dispenser4 - dispenser
    shot1 shot2 shot3 shot4 shot5 shot6 - shot
    shaker1 - shaker
  )

  (:init
    (handempty left)
    (handempty right)
    (next level0 level1)
    (next level1 level2)
    (ontable shot1)
    (empty shot1)
    (clean shot1)
    (= (container-capacity shot1) 50)
    (= (liquid-volume shot1) 0)
    (ontable shot2)
    (empty shot2)
    (clean shot2)
    (= (container-capacity shot2) 50)
    (= (liquid-volume shot2) 0)
    (ontable shot3)
    (empty shot3)
    (clean shot3)
    (= (container-capacity shot3) 50)
    (= (liquid-volume shot3) 0)
    (ontable shot4)
    (empty shot4)
    (clean shot4)
    (= (container-capacity shot4) 50)
    (= (liquid-volume shot4) 0)
    (ontable shot5)
    (empty shot5)
    (clean shot5)
    (= (container-capacity shot5) 50)
    (= (liquid-volume shot5) 0)
    (ontable shot6)
    (empty shot6)
    (clean shot6)
    (= (container-capacity shot6) 50)
    (= (liquid-volume shot6) 0)
    (ontable shaker1)
    (empty shaker1)
    (clean shaker1)
    (shaker-empty-level shaker1 level0)
    (shaker-level shaker1 level0)
    (= (container-capacity shaker1) 100)
    (= (liquid-volume shaker1) 0)
    (dispenses dispenser1 ingredient1)
    (= (dispense-amount dispenser1) 50)
    (= (dispenser-stock dispenser1) 150)
    (dispenses dispenser2 ingredient2)
    (= (dispense-amount dispenser2) 50)
    (= (dispenser-stock dispenser2) 100)
    (dispenses dispenser3 ingredient3)
    (= (dispense-amount dispenser3) 50)
    (= (dispenser-stock dispenser3) 100)
    (dispenses dispenser4 ingredient4)
    (= (dispense-amount dispenser4) 50)
    (= (dispenser-stock dispenser4) 50)
    (cocktail-part1 cocktail1 ingredient2)
    (cocktail-part2 cocktail1 ingredient3)
    (cocktail-part1 cocktail2 ingredient1)
    (cocktail-part2 cocktail2 ingredient3)
    (cocktail-part1 cocktail3 ingredient1)
    (cocktail-part2 cocktail3 ingredient2)
    (= (grasp-time) 1)
    (= (leave-time) 1)
    (= (fill-time) 3)
    (= (refill-time) 2)
    (= (pour-time) 2)
    (= (empty-time) 1)
    (= (clean-shot-time) 6)
    (= (clean-shaker-time) 10)
    (= (shake-time) 8)
    (= (total-barman-time) 0)
  )

  (:goal (and
    (handempty left)
    (handempty right)
    (contains shot1 ingredient1)
    (ontable shot1)
    (contains shot2 cocktail1)
    (ontable shot2)
    (contains shot3 cocktail3)
    (ontable shot3)
    (contains shot4 ingredient2)
    (ontable shot4)
    (contains shot5 cocktail2)
    (ontable shot5)
    (contains shot6 cocktail1)
    (ontable shot6)
    (ontable shaker1)
  ))

  (:metric minimize (total-barman-time))
)
