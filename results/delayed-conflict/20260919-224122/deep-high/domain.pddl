  (:predicates (at ?n - node) (edge ?from ?to - node) (terminal ?n - node) (done))
  (:functions (fuel) (total-cost) (edge-cost ?from ?to - node))
  (:action a-move
    :parameters (?from ?to - node)
    :precondition (and (at ?from) (edge ?from ?to)
                       (>= (fuel) (edge-cost ?from ?to)))
