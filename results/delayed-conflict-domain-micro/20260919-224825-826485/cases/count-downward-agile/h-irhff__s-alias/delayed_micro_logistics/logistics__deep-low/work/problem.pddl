(define (problem logistics-delayed-deep-b0)
  (:domain logistic)
  (:objects driver1 truck1 pack1 n0 n1 n2 n3 n4)
  (:init
    (driver driver1) (truck truck1) (package pack1) (place n0) (place n1) (place n2) (place n3) (place n4)
    (at truck1 n0) (in driver1 truck1) (loaded pack1 truck1)
    (local-road n0 n1)
    (local-road n1 n2)
    (local-road n2 n3)
    (local-road n3 n4)
    (= (package-weight pack1) 1)
    (= (truck-capacity truck1) 10) (= (truck-load truck1) 1)
    (= (fuel-capacity truck1) 10) (= (fuel-level truck1) 10)
    (= (manual-capacity driver1) 0)
    (= (refuel-cost truck1) 100) (= (refuel-time truck1) 1)
    (= (distance n0 n1) 1)
    (= (local-road-time n0 n1) 1)
    (= (distance n1 n2) 1)
    (= (local-road-time n1 n2) 1)
    (= (distance n2 n3) 6)
    (= (local-road-time n2 n3) 6)
    (= (distance n3 n4) 6)
    (= (local-road-time n3 n4) 6)
    (= (budget) 0) (= (total-cost) 0) (= (total-delivery-time) 0)
  )
  (:goal (at pack1 n4))
  (:metric minimize (total-delivery-time))
)
