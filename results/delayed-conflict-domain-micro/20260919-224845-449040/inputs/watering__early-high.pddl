(define (problem watering-delayed-early-b2)
  (:domain robotic-watering)
  (:objects robot1 - robot can1 - container plant1 - plant n0 n1 n2 n3 n4 side0_0 side0_1 side1_0 side1_1 side2_0 side2_1 - location)
  (:init
    (at-robot robot1 n0)
    (holding robot1 can1)
    (plant-at plant1 n4)
    (connected n0 n1)
    (connected n1 n2)
    (connected n2 n3)
    (connected n3 n4)
    (connected n0 side0_0)
    (connected n0 side0_1)
    (connected n1 side1_0)
    (connected n1 side1_1)
    (connected n2 side2_0)
    (connected n2 side2_1)
    (= (battery-capacity robot1) 10)
    (= (battery-level robot1) 10)
    (= (container-capacity can1) 1)
    (= (water-level can1) 1)
    (= (plant-demand plant1) 1)
    (= (watered-amount plant1) 0)
    (= (move-energy n0 n1) 6)
    (= (move-time n0 n1) 6)
    (= (move-energy n1 n2) 6)
    (= (move-time n1 n2) 6)
    (= (move-energy n2 n3) 1)
    (= (move-time n2 n3) 1)
    (= (move-energy n3 n4) 1)
    (= (move-time n3 n4) 1)
    (= (move-energy n0 side0_0) 1)
    (= (move-time n0 side0_0) 1)
    (= (move-energy n0 side0_1) 1)
    (= (move-time n0 side0_1) 1)
    (= (move-energy n1 side1_0) 1)
    (= (move-time n1 side1_0) 1)
    (= (move-energy n1 side1_1) 1)
    (= (move-time n1 side1_1) 1)
    (= (move-energy n2 side2_0) 1)
    (= (move-time n2 side2_0) 1)
    (= (move-energy n2 side2_1) 1)
    (= (move-time n2 side2_1) 1)
    (= (pick-time) 1) (= (drop-time) 1) (= (fill-time) 1)
    (= (watering-unit-time) 1) (= (charge-time) 1)
    (= (pick-energy) 1) (= (drop-energy) 1) (= (fill-energy) 1)
    (= (watering-unit-energy) 1) (= (total-watering-time) 0)
  )
  (:goal (>= (watered-amount plant1) (plant-demand plant1)))
  (:metric minimize (total-watering-time))
)
