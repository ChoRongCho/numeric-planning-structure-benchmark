(define (problem robotic-watering-p001) (:domain robotic-watering)
  (:objects
    robot1 - robot
    watering-can1 - container
    plant1 plant2 plant3 - plant
    base zone1 zone2 zone3 zone4 - location
  )

  (:init
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (home base)
    (tap zone2)
    (charging-station base)
    (charging-station zone1)
    (plant-at plant1 zone3)
    (plant-at plant2 zone3)
    (plant-at plant3 zone1)
    (connected base zone1) (connected zone1 base)
    (= (move-energy base zone1) 8) (= (move-energy zone1 base) 8)
    (= (move-time base zone1) 10) (= (move-time zone1 base) 10)
    (connected base zone3) (connected zone3 base)
    (= (move-energy base zone3) 10) (= (move-energy zone3 base) 10)
    (= (move-time base zone3) 12) (= (move-time zone3 base) 12)
    (connected base zone4) (connected zone4 base)
    (= (move-energy base zone4) 8) (= (move-energy zone4 base) 8)
    (= (move-time base zone4) 12) (= (move-time zone4 base) 12)
    (connected zone1 zone4) (connected zone4 zone1)
    (= (move-energy zone1 zone4) 3) (= (move-energy zone4 zone1) 3)
    (= (move-time zone1 zone4) 4) (= (move-time zone4 zone1) 4)
    (connected zone2 zone4) (connected zone4 zone2)
    (= (move-energy zone2 zone4) 3) (= (move-energy zone4 zone2) 3)
    (= (move-time zone2 zone4) 6) (= (move-time zone4 zone2) 6)
    (connected zone3 zone4) (connected zone4 zone3)
    (= (move-energy zone3 zone4) 4) (= (move-energy zone4 zone3) 4)
    (= (move-time zone3 zone4) 7) (= (move-time zone4 zone3) 7)
    (= (battery-capacity robot1) 114)
    (= (battery-level robot1) 114)
    (= (container-capacity watering-can1) 8)
    (= (water-level watering-can1) 0)
    (= (plant-demand plant1) 3)
    (= (watered-amount plant1) 0)
    (= (plant-demand plant2) 2)
    (= (watered-amount plant2) 0)
    (= (plant-demand plant3) 3)
    (= (watered-amount plant3) 0)
    (= (pick-time) 1)
    (= (drop-time) 1)
    (= (fill-time) 6)
    (= (watering-unit-time) 2)
    (= (charge-time) 15)
    (= (pick-energy) 1)
    (= (drop-energy) 1)
    (= (fill-energy) 2)
    (= (watering-unit-energy) 1)
    (= (total-watering-time) 0)
  )

  (:goal (and
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (>= (watered-amount plant1) (plant-demand plant1))
    (>= (watered-amount plant2) (plant-demand plant2))
    (>= (watered-amount plant3) (plant-demand plant3))
  ))

  (:metric minimize (total-watering-time))
)
