(define (problem robotic-watering-p002) (:domain robotic-watering)
  (:objects
    robot1 - robot
    watering-can1 - container
    plant1 plant2 plant3 plant4 - plant
    base zone1 zone2 zone3 zone4 zone5 - location
  )

  (:init
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (home base)
    (tap zone2)
    (charging-station base)
    (charging-station zone3)
    (plant-at plant1 zone3)
    (plant-at plant2 zone1)
    (plant-at plant3 zone1)
    (plant-at plant4 zone1)
    (connected base zone1) (connected zone1 base)
    (= (move-energy base zone1) 5) (= (move-energy zone1 base) 5)
    (= (move-time base zone1) 7) (= (move-time zone1 base) 7)
    (connected base zone3) (connected zone3 base)
    (= (move-energy base zone3) 3) (= (move-energy zone3 base) 3)
    (= (move-time base zone3) 4) (= (move-time zone3 base) 4)
    (connected zone1 zone2) (connected zone2 zone1)
    (= (move-energy zone1 zone2) 6) (= (move-energy zone2 zone1) 6)
    (= (move-time zone1 zone2) 8) (= (move-time zone2 zone1) 8)
    (connected zone1 zone3) (connected zone3 zone1)
    (= (move-energy zone1 zone3) 5) (= (move-energy zone3 zone1) 5)
    (= (move-time zone1 zone3) 6) (= (move-time zone3 zone1) 6)
    (connected zone1 zone4) (connected zone4 zone1)
    (= (move-energy zone1 zone4) 3) (= (move-energy zone4 zone1) 3)
    (= (move-time zone1 zone4) 6) (= (move-time zone4 zone1) 6)
    (connected zone2 zone3) (connected zone3 zone2)
    (= (move-energy zone2 zone3) 9) (= (move-energy zone3 zone2) 9)
    (= (move-time zone2 zone3) 11) (= (move-time zone3 zone2) 11)
    (connected zone2 zone5) (connected zone5 zone2)
    (= (move-energy zone2 zone5) 9) (= (move-energy zone5 zone2) 9)
    (= (move-time zone2 zone5) 11) (= (move-time zone5 zone2) 11)
    (connected zone3 zone4) (connected zone4 zone3)
    (= (move-energy zone3 zone4) 6) (= (move-energy zone4 zone3) 6)
    (= (move-time zone3 zone4) 9) (= (move-time zone4 zone3) 9)
    (= (battery-capacity robot1) 177)
    (= (battery-level robot1) 177)
    (= (container-capacity watering-can1) 18)
    (= (water-level watering-can1) 0)
    (= (plant-demand plant1) 4)
    (= (watered-amount plant1) 0)
    (= (plant-demand plant2) 5)
    (= (watered-amount plant2) 0)
    (= (plant-demand plant3) 5)
    (= (watered-amount plant3) 0)
    (= (plant-demand plant4) 4)
    (= (watered-amount plant4) 0)
    (= (pick-time) 1)
    (= (drop-time) 1)
    (= (fill-time) 6)
    (= (watering-unit-time) 2)
    (= (charge-time) 15)
    (= (pick-energy) 1)
    (= (drop-energy) 1)
    (= (fill-energy) 2)
    (= (watering-unit-energy) 1)
    (= (total-watering-time) 0)
  )

  (:goal (and
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (>= (watered-amount plant1) (plant-demand plant1))
    (>= (watered-amount plant2) (plant-demand plant2))
    (>= (watered-amount plant3) (plant-demand plant3))
    (>= (watered-amount plant4) (plant-demand plant4))
  ))

  (:metric minimize (total-watering-time))
)
