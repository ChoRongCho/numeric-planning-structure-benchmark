(define (problem robotic-watering-p003) (:domain robotic-watering)
  (:objects
    robot1 - robot
    watering-can1 - container
    plant1 plant2 plant3 plant4 plant5 - plant
    base zone1 zone2 zone3 zone4 zone5 zone6 - location
  )

  (:init
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (home base)
    (tap zone6)
    (charging-station base)
    (charging-station zone2)
    (plant-at plant1 zone2)
    (plant-at plant2 zone3)
    (plant-at plant3 zone2)
    (plant-at plant4 zone4)
    (plant-at plant5 zone6)
    (connected base zone1) (connected zone1 base)
    (= (move-energy base zone1) 7) (= (move-energy zone1 base) 7)
    (= (move-time base zone1) 8) (= (move-time zone1 base) 8)
    (connected base zone4) (connected zone4 base)
    (= (move-energy base zone4) 6) (= (move-energy zone4 base) 6)
    (= (move-time base zone4) 9) (= (move-time zone4 base) 9)
    (connected zone1 zone3) (connected zone3 zone1)
    (= (move-energy zone1 zone3) 7) (= (move-energy zone3 zone1) 7)
    (= (move-time zone1 zone3) 8) (= (move-time zone3 zone1) 8)
    (connected zone1 zone4) (connected zone4 zone1)
    (= (move-energy zone1 zone4) 8) (= (move-energy zone4 zone1) 8)
    (= (move-time zone1 zone4) 9) (= (move-time zone4 zone1) 9)
    (connected zone2 zone3) (connected zone3 zone2)
    (= (move-energy zone2 zone3) 9) (= (move-energy zone3 zone2) 9)
    (= (move-time zone2 zone3) 10) (= (move-time zone3 zone2) 10)
    (connected zone2 zone5) (connected zone5 zone2)
    (= (move-energy zone2 zone5) 6) (= (move-energy zone5 zone2) 6)
    (= (move-time zone2 zone5) 10) (= (move-time zone5 zone2) 10)
    (connected zone3 zone4) (connected zone4 zone3)
    (= (move-energy zone3 zone4) 9) (= (move-energy zone4 zone3) 9)
    (= (move-time zone3 zone4) 10) (= (move-time zone4 zone3) 10)
    (connected zone3 zone6) (connected zone6 zone3)
    (= (move-energy zone3 zone6) 5) (= (move-energy zone6 zone3) 5)
    (= (move-time zone3 zone6) 9) (= (move-time zone6 zone3) 9)
    (connected zone5 zone6) (connected zone6 zone5)
    (= (move-energy zone5 zone6) 9) (= (move-energy zone6 zone5) 9)
    (= (move-time zone5 zone6) 12) (= (move-time zone6 zone5) 12)
    (= (battery-capacity robot1) 74)
    (= (battery-level robot1) 74)
    (= (container-capacity watering-can1) 8)
    (= (water-level watering-can1) 0)
    (= (plant-demand plant1) 2)
    (= (watered-amount plant1) 0)
    (= (plant-demand plant2) 5)
    (= (watered-amount plant2) 0)
    (= (plant-demand plant3) 6)
    (= (watered-amount plant3) 0)
    (= (plant-demand plant4) 5)
    (= (watered-amount plant4) 0)
    (= (plant-demand plant5) 2)
    (= (watered-amount plant5) 0)
    (= (pick-time) 1)
    (= (drop-time) 1)
    (= (fill-time) 6)
    (= (watering-unit-time) 2)
    (= (charge-time) 15)
    (= (pick-energy) 1)
    (= (drop-energy) 1)
    (= (fill-energy) 2)
    (= (watering-unit-energy) 1)
    (= (total-watering-time) 0)
  )

  (:goal (and
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (>= (watered-amount plant1) (plant-demand plant1))
    (>= (watered-amount plant2) (plant-demand plant2))
    (>= (watered-amount plant3) (plant-demand plant3))
    (>= (watered-amount plant4) (plant-demand plant4))
    (>= (watered-amount plant5) (plant-demand plant5))
  ))

  (:metric minimize (total-watering-time))
)
