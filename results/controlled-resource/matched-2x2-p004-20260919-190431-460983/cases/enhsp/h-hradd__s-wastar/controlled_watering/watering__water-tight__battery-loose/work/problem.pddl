(define (problem robotic-watering-p004) (:domain robotic-watering)
  (:objects
    robot1 - robot
    watering-can1 - container
    plant1 plant2 plant3 plant4 plant5 plant6 - plant
    base zone1 zone2 zone3 zone4 zone5 zone6 zone7 - location
  )

  (:init
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (home base)
    (tap zone3)
    (tap zone6)
    (charging-station base)
    (charging-station zone5)
    (plant-at plant1 zone4)
    (plant-at plant2 zone2)
    (plant-at plant3 zone5)
    (plant-at plant4 zone7)
    (plant-at plant5 zone3)
    (plant-at plant6 zone2)
    (connected base zone1) (connected zone1 base)
    (= (move-energy base zone1) 3) (= (move-energy zone1 base) 3)
    (= (move-time base zone1) 4) (= (move-time zone1 base) 4)
    (connected base zone4) (connected zone4 base)
    (= (move-energy base zone4) 10) (= (move-energy zone4 base) 10)
    (= (move-time base zone4) 12) (= (move-time zone4 base) 12)
    (connected base zone5) (connected zone5 base)
    (= (move-energy base zone5) 5) (= (move-energy zone5 base) 5)
    (= (move-time base zone5) 8) (= (move-time zone5 base) 8)
    (connected zone1 zone6) (connected zone6 zone1)
    (= (move-energy zone1 zone6) 7) (= (move-energy zone6 zone1) 7)
    (= (move-time zone1 zone6) 10) (= (move-time zone6 zone1) 10)
    (connected zone2 zone3) (connected zone3 zone2)
    (= (move-energy zone2 zone3) 8) (= (move-energy zone3 zone2) 8)
    (= (move-time zone2 zone3) 9) (= (move-time zone3 zone2) 9)
    (connected zone2 zone7) (connected zone7 zone2)
    (= (move-energy zone2 zone7) 5) (= (move-energy zone7 zone2) 5)
    (= (move-time zone2 zone7) 9) (= (move-time zone7 zone2) 9)
    (connected zone3 zone5) (connected zone5 zone3)
    (= (move-energy zone3 zone5) 9) (= (move-energy zone5 zone3) 9)
    (= (move-time zone3 zone5) 12) (= (move-time zone5 zone3) 12)
    (connected zone3 zone7) (connected zone7 zone3)
    (= (move-energy zone3 zone7) 10) (= (move-energy zone7 zone3) 10)
    (= (move-time zone3 zone7) 13) (= (move-time zone7 zone3) 13)
    (connected zone4 zone5) (connected zone5 zone4)
    (= (move-energy zone4 zone5) 3) (= (move-energy zone5 zone4) 3)
    (= (move-time zone4 zone5) 7) (= (move-time zone5 zone4) 7)
    (connected zone5 zone6) (connected zone6 zone5)
    (= (move-energy zone5 zone6) 8) (= (move-energy zone6 zone5) 8)
    (= (move-time zone5 zone6) 12) (= (move-time zone6 zone5) 12)
    (connected zone5 zone7) (connected zone7 zone5)
    (= (move-energy zone5 zone7) 8) (= (move-energy zone7 zone5) 8)
    (= (move-time zone5 zone7) 11) (= (move-time zone7 zone5) 11)
    (= (battery-capacity robot1) 141)
    (= (battery-level robot1) 141)
    (= (container-capacity watering-can1) 9)
    (= (water-level watering-can1) 0)
    (= (plant-demand plant1) 3)
    (= (watered-amount plant1) 0)
    (= (plant-demand plant2) 6)
    (= (watered-amount plant2) 0)
    (= (plant-demand plant3) 6)
    (= (watered-amount plant3) 0)
    (= (plant-demand plant4) 6)
    (= (watered-amount plant4) 0)
    (= (plant-demand plant5) 3)
    (= (watered-amount plant5) 0)
    (= (plant-demand plant6) 5)
    (= (watered-amount plant6) 0)
    (= (pick-time) 1)
    (= (drop-time) 1)
    (= (fill-time) 6)
    (= (watering-unit-time) 2)
    (= (charge-time) 15)
    (= (pick-energy) 1)
    (= (drop-energy) 1)
    (= (fill-energy) 2)
    (= (watering-unit-energy) 1)
    (= (total-watering-time) 0)
  )

  (:goal (and
    (at-robot robot1 base)
    (container-at watering-can1 base)
    (hand-free robot1)
    (>= (watered-amount plant1) (plant-demand plant1))
    (>= (watered-amount plant2) (plant-demand plant2))
    (>= (watered-amount plant3) (plant-demand plant3))
    (>= (watered-amount plant4) (plant-demand plant4))
    (>= (watered-amount plant5) (plant-demand plant5))
    (>= (watered-amount plant6) (plant-demand plant6))
  ))

  (:metric minimize (total-watering-time))
)
