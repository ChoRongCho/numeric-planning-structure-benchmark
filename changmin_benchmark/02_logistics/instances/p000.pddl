(define (problem logistics-p000)
  (:domain logistic)
  (:objects driver1 truck1 pack1 place1 place2)
  (:init
    (driver driver1)
    (truck truck1)
    (package pack1)
    (place place1)
    (place place2)
    (at truck1 place1)
    (loaded pack1 truck1)
    (in driver1 truck1)
    (fuel-station place1)
    (local-road place1 place2)
    (= (package-weight pack1) 50)
    (= (manual-capacity driver1) 100)
    (= (truck-capacity truck1) 1000)
    (= (truck-load truck1) 50)
    (= (fuel-capacity truck1) 10)
    (= (fuel-level truck1) 10)
    (= (refuel-cost truck1) 1)
    (= (refuel-time truck1) 1)
    (= (distance place1 place2) 1)
    (= (local-road-time place1 place2) 2)
    (= (budget) 10)
    (= (total-cost) 0)
    (= (total-delivery-time) 0)
  )
  (:goal (at pack1 place2))
  (:metric minimize (total-delivery-time))
)
