(define (problem library-rearrangement-p002) (:domain library-books)
  (:objects
    robot1 - robot
    book001 book002 book003 book004 book005 book006 book007 book008 book009 book010 - book
    cart1 - cart
    return-room aisle1 aisle2 - room
    shelf1 shelf2 shelf3 - shelf
    step1 - step
    s1-slot1 s1-slot2 s1-slot3 s1-slot4 s2-slot1 s2-slot2 s2-slot3 s3-slot1 s3-slot2 s3-slot3 - slot
    s1-end s2-end s3-end - end-marker
  )

  (:init
    (at-robot robot1 return-room)
    (hand-free robot1)
    (without-cart robot1)
    (grounded robot1)
    (cart-at cart1 return-room)
    (staging-area return-room)
    (staging-area aisle1)
    (staging-area aisle2)
    (connected aisle1 aisle2) (connected aisle2 aisle1)
    (connected aisle2 return-room) (connected return-room aisle2)
    (shelf-at shelf1 aisle1)
    (shelf-at shelf2 aisle2)
    (shelf-at shelf3 aisle1)
    (step-at step1 aisle1)
    (step-ready step1)

    (on-shelf book001 shelf1 s1-slot1)
    (next-to-fill shelf1 s1-slot2)
    (successor s1-slot1 s1-slot2 shelf1)
    (successor s1-slot2 s1-slot3 shelf1)
    (successor s1-slot3 s1-slot4 shelf1)
    (successor s1-slot4 s1-end shelf1)
    (on-shelf book005 shelf2 s2-slot1)
    (on-shelf book007 shelf2 s2-slot2)
    (next-to-fill shelf2 s2-slot3)
    (successor s2-slot1 s2-slot2 shelf2)
    (successor s2-slot2 s2-slot3 shelf2)
    (successor s2-slot3 s2-end shelf2)
    (on-shelf book008 shelf3 s3-slot1)
    (on-shelf book010 shelf3 s3-slot2)
    (next-to-fill shelf3 s3-slot3)
    (successor s3-slot1 s3-slot2 shelf3)
    (successor s3-slot2 s3-slot3 shelf3)
    (successor s3-slot3 s3-end shelf3)
    (assigned book001 shelf1 s1-slot1)
    (book-at book002 return-room)
    (assigned book002 shelf1 s1-slot2)
    (book-at book003 return-room)
    (assigned book003 shelf1 s1-slot3)
    (book-at book004 return-room)
    (assigned book004 shelf1 s1-slot4)
    (assigned book005 shelf2 s2-slot1)
    (book-at book006 return-room)
    (assigned book006 shelf2 s2-slot2)
    (assigned book007 shelf2 s2-slot3)
    (assigned book008 shelf3 s3-slot1)
    (book-at book009 return-room)
    (assigned book009 shelf3 s3-slot2)
    (assigned book010 shelf3 s3-slot3)

    (= (book-weight book001) 5)
    (= (book-thickness book001) 4)
    (= (book-weight book002) 1)
    (= (book-thickness book002) 1)
    (= (book-weight book003) 4)
    (= (book-thickness book003) 1)
    (= (book-weight book004) 4)
    (= (book-thickness book004) 1)
    (= (book-weight book005) 2)
    (= (book-thickness book005) 4)
    (= (book-weight book006) 1)
    (= (book-thickness book006) 3)
    (= (book-weight book007) 1)
    (= (book-thickness book007) 1)
    (= (book-weight book008) 3)
    (= (book-thickness book008) 2)
    (= (book-weight book009) 5)
    (= (book-thickness book009) 3)
    (= (book-weight book010) 5)
    (= (book-thickness book010) 4)
    (= (cart-capacity cart1) 7)
    (= (cart-load cart1) 0)
    (= (shelf-capacity shelf1) 7)
    (= (shelf-used-space shelf1) 4)
    (= (shelf-height shelf1) 175)
    (= (shelf-capacity shelf2) 8)
    (= (shelf-used-space shelf2) 5)
    (= (shelf-height shelf2) 166)
    (= (shelf-capacity shelf3) 9)
    (= (shelf-used-space shelf3) 6)
    (= (shelf-height shelf3) 221)
    (= (current-reach robot1) 180)
    (= (step-boost step1) 60)
    (= (move-alone-time) 8)
    (= (move-cart-time) 10)
    (= (cart-handling-time) 2)
    (= (book-handling-time) 1)
    (= (shelf-handling-time) 2)
    (= (step-handling-time) 5)
    (= (total-library-time) 0)
  )

  (:goal (and
    (on-shelf book001 shelf1 s1-slot1)
    (on-shelf book002 shelf1 s1-slot2)
    (on-shelf book003 shelf1 s1-slot3)
    (on-shelf book004 shelf1 s1-slot4)
    (on-shelf book005 shelf2 s2-slot1)
    (on-shelf book006 shelf2 s2-slot2)
    (on-shelf book007 shelf2 s2-slot3)
    (on-shelf book008 shelf3 s3-slot1)
    (on-shelf book009 shelf3 s3-slot2)
    (on-shelf book010 shelf3 s3-slot3)
    (next-to-fill shelf1 s1-end)
    (next-to-fill shelf2 s2-end)
    (next-to-fill shelf3 s3-end)
  ))

  (:metric minimize (total-library-time))
)
